# =====================================================================
# .env.example - copie este archivo a .env y complete los valores.
# NUNCA suba el archivo .env real al repositorio (está en .gitignore).
# =====================================================================

# --- Versionado de imágenes / registro ---
VERSION=0.2.0
# REGISTRO=docker.io/tu-usuario        # o ghcr.io/tu-usuario

# --- Modelo desde bucket (opcional; si se omite, se usa models/model.joblib) ---
# MODEL_S3_URI=s3://mi-bucket/modelos/model.joblib
# S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com   # o http://minio:9000
# AWS_ACCESS_KEY_ID=tu_access_key
# AWS_SECRET_ACCESS_KEY=tu_secret_key
# AWS_REGION=us-east-1

# --- Servicio LLM (OpenAI) ---
OPENAI_API_KEY=sk-...tu_llave...
LLM_MODEL=gpt-4o-mini
MAX_TOKENS=300
# LLM_MOCK=true        # pon true para probar sin llave (respuesta simulada)
